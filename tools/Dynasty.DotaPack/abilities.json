  "_about": "Dota hero abilities in the engine's effect tree (docs/DOTA_PACK.md, wave 2). Values are references to dotaconstants keys: \"$key\", \"-$key\" (negated). Cooldown, mana cost, cast range and cast point come from the data unless given here. status: full or simplified (with a note on what is left out).",
  "hoodwink_acorn_shot": {
    "status": "simplified",
    "note": "no bounces; the attack-damage part is left out",
    "targeting": "unit",
    "targetTeam": "enemy",
    "effects": [
      {
        "kind": "damage",
        "damageType": "physical",
        "amounts": "$acorn_shot_damage"
      },
      {
        "kind": "modifier",
        "modifiers": {
          "key": "hoodwink_acorn_shot",
          "duration": "$debuff_duration",
          "moveSpeedPercent": "-$slow"
        }
      }
    ]
  },
